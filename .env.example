# Groq / Grok API Key for AI Travel Planner & Chat
GROQ_API_KEY="your_groq_or_grok_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"

# Optional Grok / xAI key (if using xAI endpoint https://api.x.ai/v1)
GROK_API_KEY=""

# Optional Gemini key (fallback if needed)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# JWT secret for traveler session authentication
JWT_SECRET="CHANGE_ME_DEV_SECRET"

# Optional external Spring Boot 4.1.0 + MySQL 8 backend URL (e.g., http://localhost:8081)
SPRING_BOOT_API_URL=""

# Supabase Cloud Database & Authentication
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"
